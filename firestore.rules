
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rider Location rules
    match /riderLocations/{riderUid} {
      allow read: if request.auth != null && (request.auth.uid == riderUid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == riderUid;
    }
    
    // Existing catch-all for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
